{
  "name": "dsh-vertex-argon",
  "version": "1.5.1",
  "description": "Gemini API and Vertex AI Argon for DSH: long decode, explicit service tiers, response and usage inspection, and estimated costs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higekibaka/dsh-vertex-argon.git"
  },
  "bugs": "https://github.com/higekibaka/dsh-vertex-argon/issues",
  "homepage": "https://github.com/higekibaka/dsh-vertex-argon#readme",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "runtime.js",
    "index.js",
    "adapter.js",
    "diagnostics.js",
    "diagnostic-store.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "generate-content.js",
    "google-connection.js",
    "interaction-transport.js",
    "interaction-state.js",
    "interaction-lifecycle.js",
    "service-level.js",
    "google-signatures.js",
    "usage-details.js",
    "pricing.js",
    "response-store.js",
    "bounded-json.js",
    "structured-output.js",
    "interaction-query.js",
    "inspector-service.js",
    "inspector-overview.js",
    "inspector-tool.js",
    "request-association.js",
    "interaction-adapter.js",
    "interaction-image.js",
    "interactions.js",
    "interactions-input.js",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vertex-ai",
    "gemini",
    "gemini-4-argon",
    "plugin"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "1.1.0",
    "@google/genai": "2.21.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --experimental-transform-types --import ./test/host-loader.mjs --test test/*.test.mjs"
  }
}
